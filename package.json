{
  "name": "attache",
  "description": "Attaché — a fully on-device research copilot. LiteRT.js + Gemma demo, production-grade architecture.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-wasm.mjs",
    "docker:build": "docker build -f deployment/Dockerfile -t attache:local .",
    "docker:up": "docker compose -f deployment/docker-compose.yml up --build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource/spline-sans-mono": "^5.2.0",
    "@litertjs/core": "^2.5.2",
    "@mediapipe/tasks-genai": "^0.10.24",
    "@mediapipe/tasks-text": "^0.10.22",
    "@sctg/sentencepiece-js": "^1.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
